{
  "name": "actari-mcp",
  "version": "0.23.0",
  "private": false,
  "type": "module",
  "description": "Task journal for AI agents: event sourcing over SQLite with an MCP interface. Policies set the rules. Zero dependencies.",
  "keywords": [
    "mcp",
    "mcp-server",
    "delegation",
    "event-sourcing",
    "sqlite",
    "ai-agents",
    "orchestration",
    "policy"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actari/actari-mcp.git"
  },
  "homepage": "https://github.com/actari/actari-mcp#readme",
  "bugs": {
    "url": "https://github.com/actari/actari-mcp/issues"
  },
  "files": [
    "server.mjs",
    "adr.mjs",
    "tool-args.mjs",
    "sync.mjs",
    "policy.mjs",
    "intent.mjs",
    "env.mjs",
    "usage-file.mjs",
    "usage-session.mjs",
    "search-index.mjs",
    "vendor/",
    "skills/",
    "schema.sql",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "actari": "server.mjs",
    "actari-mcp": "server.mjs",
    "actari-sync": "sync.mjs"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "vendor:search": "node scripts/vendor-search.mjs"
  },
  "devDependencies": {
    "@actari/search": "workspace:*"
  },
  "engines": {
    "node": ">=22.5"
  }
}
